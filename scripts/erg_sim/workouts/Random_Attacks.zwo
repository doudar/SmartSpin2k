<workout_file>
    <author>GCN</author>
    <name>Random attacks</name>
    <description>To prep you for the random nature of bike racing, here are a bunch of attack simulations of random length and intensities.  Go for it!  
Warm up for 10minutes with 3 x 1 minute fast pedaling drills &gt;110rpm. 

Then ride at tempo pace and complete the hard hills!
Added small-step control checks: two 6:45 blocks with 10, 20, 30 and 40 W changes at FTP 305.
Cool-down</description>
    <sportType>bike</sportType>
    <tags>
        <tag name="INTERVALS"/>
    </tags>
    <workout>
        <Warmup Duration="600" PowerLow="0.25" PowerHigh="0.75"/>
        <IntervalsT Repeat="3" OnDuration="60" OffDuration="60" OnPower="0.75" OffPower="0.5"/>
        <SteadyState Duration="60" Power="1.25"/>
